# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env إلى git أبداً
PORT=4000
PUBLIC_URL=https://your-server.example.com   # رابط سيرفرك العام (ngrok أو Render) — ليس رابط زائر
MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/sahil
TZ_NAME=Asia/Amman
DEFAULT_COUNTRY_CODE=962
CORS_ORIGINS=http://localhost:5173

# لوحة التحكم
JWT_SECRET=ضع-نصاً-عشوائياً-طويلاً
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=
MANAGER_PHONE=9627XXXXXXXX                   # رقم المدير (يُسجَّل كموظف ويستلم الموافقات والتنبيهات)
MANAGER_NAME=المدير

# واتساب (Meta Cloud API)
GRAPH_API_VERSION=v23.0
PHONE_NUMBER_ID=
ACCESS_TOKEN=                                # توكن دائم من System User
VERIFY_TOKEN=
META_APP_SECRET=                             # App secret (32 حرف hex) للتحقق من توقيع الـ webhook
WA_TEMPLATE_LANG=ar
# للاختبار فقط: الإرسال الفعلي لهذه الأرقام فقط، والباقي يُطبع في السجل. اتركه فارغاً في الإنتاج
WA_SEND_ONLY_TO=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# زائر
ZAAER_BASE_URL=https://sahl-suites.zaaer.com/api/v1
ZAAER_API_TOKEN=
ZAAER_PROPERTY_ID=1
ZAAER_CURRENCY=JOD
ZAAER_CACHE_SECONDS=120
ZAAER_HOLD_IN_ZAAER=true
# نقاط غير موثّقة بعد — فارغة = تنبيه يدوي للموظف المختص. {id}=رقم زائر، {booking_id}=رقمنا B-xxx
ZAAER_RECEIPT_METHOD=
ZAAER_RECEIPT_PATH=
ZAAER_CHECKIN_METHOD=
ZAAER_CHECKIN_PATH=
ZAAER_CHECKOUT_GUEST_METHOD=
ZAAER_CHECKOUT_GUEST_PATH=
ZAAER_BALANCES_METHOD=get
ZAAER_BALANCES_PATH=
ZAAER_CHECKOUT_ENABLED=false
ZAAER_CHECKOUT_PATH=/payment-checkouts
ZAAER_PAYMENT_RETURN_URL=

# برنامج الدراي كلين
DRYCLEAN_API_URL=
DRYCLEAN_API_USER=
DRYCLEAN_API_PASSWORD=
DRYCLEAN_WHATSAPP=

# التوصيل
DELIVERY_MODE=whatsapp
DELIVERY_WHATSAPP=
DELIVERY_API_URL=
DELIVERY_API_KEY=
